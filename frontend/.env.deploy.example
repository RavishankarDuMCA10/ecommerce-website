# Deploy script environment variables
# Copy this file to .env.deploy, fill in values, and DO NOT commit it to git.

DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_access_token
DOCKERHUB_IMAGE=your_dockerhub_username/ecommerce-frontend

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

ECS_CLUSTER=your_ecs_cluster_name
ECS_SERVICE=your_ecs_service_name

VITE_API_URL=https://your-backend-api.com
